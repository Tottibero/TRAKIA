{
  "name": "trakia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "12.19.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @trakia/contracts build && pnpm --filter @trakia/web dev",
    "dev:api": "pnpm --filter @trakia/contracts build && pnpm --filter @trakia/api dev",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "architecture:check": "node scripts/architecture-check.mjs",
    "test": "pnpm --filter @trakia/api test",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "auth:bootstrap": "pnpm --filter @trakia/api build && node apps/api/scripts/auth-admin.mjs bootstrap",
    "auth:reset-password": "pnpm --filter @trakia/api build && node apps/api/scripts/auth-admin.mjs reset-password",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm architecture:check && pnpm test && pnpm build",
    "build": "pnpm --filter @trakia/contracts build && pnpm --filter @trakia/web build && pnpm --filter @trakia/api build",
    "typecheck": "pnpm --filter @trakia/contracts typecheck && pnpm --filter @trakia/web typecheck && pnpm --filter @trakia/api typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.2",
    "vue-eslint-parser": "^10.4.2"
  }
}
