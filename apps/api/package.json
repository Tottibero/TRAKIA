{
  "name": "@trakia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch ../../packages/contracts/dist --ext ts,js,json --exec \"nest start --watch\"",
    "dev:docker": "nodemon --watch src --watch ../../packages/contracts/dist --ext ts,js,json --exec \"nest start --watch --config nest-cli.docker.json\"",
    "build": "nest build",
    "db:build": "nest build --config nest-cli.docker.json",
    "db:migration:run": "typeorm migration:run -d ${TRAKIA_DB_DIST:-dist}/database/data-source.js",
    "db:migration:show": "typeorm migration:show -d ${TRAKIA_DB_DIST:-dist}/database/data-source.js",
    "db:migration:revert": "typeorm migration:revert -d ${TRAKIA_DB_DIST:-dist}/database/data-source.js",
    "db:migration:generate": "typeorm migration:generate src/database/migrations/$npm_config_name -d ${TRAKIA_DB_DIST:-dist}/database/data-source.js",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.build.json",
    "test": "pnpm build && node --test test/auth-token.test.mjs test/database-config.test.mjs test/http-security.test.mjs test/integration-database.test.mjs test/runtime-config.test.mjs test/users.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/typeorm": "^11.0.0",
    "@trakia/contracts": "workspace:*",
    "argon2": "^0.45.2",
    "pg": "^8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@types/node": "26.6.6",
    "nodemon": "3.1.11",
    "typescript": "6.0.3"
  }
}
